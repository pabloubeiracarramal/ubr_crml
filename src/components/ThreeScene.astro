---
// src/components/ThreeScene.astro
// You can pass props to this component to customize it later
const { title = "My 3D Scene" } = Astro.props;
---

<div class="scene-container" data-title={title}></div>

<style>
  /* Ensure the container has size, otherwise the canvas will be 0px height */
  .scene-container {
    width: 100%;
    height: 100%; /* Or 100vh for full screen */
    /* background: #ADFF2F;  */
    overflow: hidden;
    border-radius: 1rem;
  }
</style>

<script>
  import * as THREE from "three";
  import { AsciiEffect } from "three/addons/effects/AsciiEffect.js";
  import { OBJLoader } from "three/addons/loaders/OBJLoader.js";

  // ==========================================
  // 1. CONFIGURATION
  // ==========================================

  // Vertical resolution (how many rows of text fit on screen)
  // Lower = bigger text, higher = smaller text
  const ROWS = 100;

  // Calculate columns based on aspect ratio so characters remain square
  const aspectRatio = window.innerWidth / window.innerHeight;
  const COLS = Math.floor(ROWS * aspectRatio);

  // ==========================================
  // 2. PROCEDURAL FONT TEXTURE GENERATOR
  // ==========================================
  // Creates a sprite sheet of characters sorted by density (dark to light)
  function createFontTexture() {
    const canvas = document.createElement("canvas");
    const ctx = canvas.getContext("2d");
    if (!ctx) throw new Error("Could not get 2d context");

    // The palette of characters.
    // Index 0 (space) is for black pixels. Last index (@) is for bright pixels.
    const charSet = " .,:-=+*#%@";

    const fontWidth = 64; // High res for crisp text
    const fontHeight = 64;

    // We create a texture that is 1 character high and N characters wide
    canvas.width = charSet.length * fontWidth;
    canvas.height = fontHeight;

    // 1. Draw the background
    ctx.fillStyle = "black";
    ctx.fillRect(0, 0, canvas.width, canvas.height);

    // 2. COnfigure the font - make it larger to fill the cell
    ctx.font = `bold ${fontWidth * 1.2}px monospace`;
    ctx.fillStyle = "white";
    ctx.textAlign = "center";
    ctx.textBaseline = "middle";

    // 3. Draw each character
    for (let i = 0; i < charSet.length; i++) {
      const char = charSet[i];
      const x = i * fontWidth + fontWidth / 2;
      const y = fontHeight / 2;
      ctx.fillText(char, x, y);
    }

    const texture = new THREE.CanvasTexture(canvas);
    // Important: NearestFilter prevents blurry edges on the text
    texture.minFilter = THREE.NearestFilter;
    texture.magFilter = THREE.NearestFilter;

    return { texture, count: charSet.length };
  }

  const fontData = createFontTexture();

  // ==========================================
  // 3. SETUP SCENE (The 3D World)
  // ==========================================
  const container = document.querySelector(".scene-container");

  if (container) {
    const scene = new THREE.Scene();
    scene.background = new THREE.Color(0x000000); // Add black background
    const loader = new OBJLoader();

    // --- CAMERA ---
    // PerspectiveCamera(Field of View, Aspect Ratio, Near Clip, Far Clip)
    const camera = new THREE.PerspectiveCamera(30, aspectRatio, 0.1, 1000);
    camera.position.z = 75;
    camera.position.y = 30;
    camera.lookAt(0, 15, 0);

    // Add white light to illuminate the scene
    const light = new THREE.DirectionalLight(0xffffff, 15);
    light.position.set(0, 100, 0);
    light.target.position.set(0, 0, 0);
    scene.add(light);

    // // Add white light to illuminate the scene
    // const light2 = new THREE.DirectionalLight(0xff8888, 15);
    // light2.position.set(0, -100, 0);
    // light2.target.position.set(0, 0, 0);
    // scene.add(light2);

    // Add a point light for additional depth
    const pointLight = new THREE.PointLight(0xffffff, 50);
    pointLight.position.set(20, 50,-20);
    scene.add(pointLight);
    
    // Add ambient light for softer overall illumination
    const ambientLight = new THREE.AmbientLight(0xffffff, 3);
    scene.add(ambientLight);

    // Create a spinning Torus Knot 
    // We use MeshNormalMaterial because it produces vibrant colors automatically
    const geometry = new THREE.TorusKnotGeometry(1.2, 0.4, 100, 16);
    const material = new THREE.MeshNormalMaterial(); 
    const torus = new THREE.Mesh(geometry, material);
    // scene.add(torus);

    // Add object - store reference for animation
    let plantModel = null;
    loader.load(
      "/models/plant.obj",
      function (object) {
        console.log("Model loaded:", object);
        
        // Apply green material to all meshes
        object.traverse((child) => {
          if (child.isMesh) {
            child.material = new THREE.MeshStandardMaterial({
              color: 0x66ff00,
              side: THREE.DoubleSide,
              roughness: 0.25,
              metalness: 0.75
            });
          }
        });
        
        object.position.set(0, 0, 0);
        object.scale.set(1, 1, 1);
        
        plantModel = object;
        scene.add(object);
      },
      function (xhr) {
        // Progress callback (optional)
        console.log((xhr.loaded / xhr.total) * 100 + "% loaded");
      },
      function (error) {
        // Error callback
        console.error("Error loading model:", error);
      },
    );

    const renderer = new THREE.WebGLRenderer({
      antialias: true, // Smooth edges
      alpha: true, // Transparent background (lets CSS background show)
    });
    renderer.setSize(container.clientWidth, container.clientHeight);
    // renderer.setPixelRatio(window.devicePixelRatio); // Sharpness on Retina screens
    container.appendChild(renderer.domElement);

    // ==========================================
    // 4. SETUP OFF-SCREEN BUFFER (Low Res)
    // ==========================================
    // This is the "tiny screen" we render the 3D world to first.
    const renderTarget = new THREE.WebGLRenderTarget(COLS, ROWS, {
      minFilter: THREE.NearestFilter,
      magFilter: THREE.NearestFilter,
      format: THREE.RGBAFormat,
    });

    // ==========================================
    // 5. SETUP POST-PROCESSING (ASCII Shader)
    // ==========================================
    const postScene = new THREE.Scene();
    const postCamera = new THREE.OrthographicCamera(-1, 1, 1, -1, 0, 1);

    const shaderMaterial = new THREE.ShaderMaterial({
      uniforms: {
        tLowRes: { value: renderTarget.texture },
        tFont: { value: fontData.texture },
        fontCount: { value: fontData.count },
        gridSize: { value: new THREE.Vector2(COLS, ROWS) },
        mouse: { value: new THREE.Vector2(-10, -10) },
        time: { value: 0 },
      },
      transparent: true,
      vertexShader: `
        varying vec2 vUv;
        void main() {
          vUv = uv;
          gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
        }
      `,
      fragmentShader: `
        uniform sampler2D tLowRes;
        uniform sampler2D tFont;
        uniform float fontCount;
        uniform vec2 gridSize;
        uniform vec2 mouse;
        uniform float time;
        varying vec2 vUv;

        void main() {
        
          // MOUSE DISPLACEMENT EFFECT
          // Calculate distance from mouse to current pixel
          vec2 toMouse = vUv - mouse;
          float distToMouse = length(toMouse);
          float maxDist = 0.3; // Radius of effect
          
          // Create displacement based on distance (stronger near mouse)
          float displacementStrength = 0.0;
          if (distToMouse < maxDist) {
            // Smooth falloff from center to edge
            float influence = 1.0 - (distToMouse / maxDist);
            influence = pow(influence, 2.0); // Quadratic falloff
            displacementStrength = influence * 0.05; // Adjust strength here
          }
          
          // Apply displacement perpendicular to mouse direction
          vec2 displacementDir = vec2(-toMouse.y, toMouse.x);
          vec2 displacedUv = vUv + displacementDir * displacementStrength;
          
          // Also add a subtle wave effect
          displacedUv.x += sin(vUv.y * 20.0 + time) * displacementStrength * 0.5;
        
          // 1. GRID CALCULATION
          // Determine which "cell" (character block) this pixel belongs to
          vec2 cellCoord = displacedUv * gridSize;
          vec2 cellIndex = floor(cellCoord);
          vec2 cellFract = fract(cellCoord);

          // 2. SAMPLE SCENE COLOR
          // We sample the low-res texture exactly at the center of our cell
          vec2 sampleUv = (cellIndex + 0.5) / gridSize;
          vec4 sceneColor = texture2D(tLowRes, sampleUv);

          // 3. CALCULATE LUMINANCE
          // Standard wightings for how human eye perceives color
          float gray = dot(sceneColor.rgb, vec3(0.299, 0.587, 0.114));

          // 4. SELECT CHARACTER
          // Map luminance (0.0 - 1.0) to a character index (0 - fontCount)
          float charIndex = floor(gray * (fontCount));
          charIndex = min(charIndex, fontCount - 1.0);

          // 5. CALCULATE FONT UV
          // We have a 1-row sprite sheet.
          // X = (Character Index + Local X position) / Total Characters
          float charWidth = 1.0 / fontCount;
          float u = (charIndex + cellFract.x) * charWidth;
          float v = cellFract.y;

          vec4 fontColor = texture2D(tFont, vec2(u, v));

          // 6. FINAL COMPOSITION
          // We multiply the font (white text) by the scene color (colored background)
          // This tints the text to match the object.
          
          // Boost brightness slightly so dark colors don't disappear
          vec3 finalColor = sceneColor.rgb * 1.5; 
                
          // If font pixel is black, output is black. 
          // If font pixel is white, output is the scene color.
          // Use fontColor.r as alpha for transparency
          gl_FragColor = vec4(finalColor * fontColor.r, fontColor.r);

        }
      `,
    });

    const plane = new THREE.Mesh(new THREE.PlaneGeometry(2, 2), shaderMaterial);

    postScene.add(plane);

    // ==========================================
    // 6. MOUSE TRACKING
    // ==========================================
    const mouse = new THREE.Vector2(-10, -10);
    
    container.addEventListener('mousemove', (event) => {
      const rect = container.getBoundingClientRect();
      // Normalize mouse coordinates to 0-1 range
      mouse.x = (event.clientX - rect.left) / rect.width;
      mouse.y = 1.0 - (event.clientY - rect.top) / rect.height; // Flip Y
      shaderMaterial.uniforms.mouse.value.copy(mouse);
    });
    
    container.addEventListener('mouseleave', () => {
      // Move mouse off screen when leaving canvas
      mouse.set(-10, -10);
      shaderMaterial.uniforms.mouse.value.copy(mouse);
    });

    // ==========================================
    // 7. RENDER LOOP
    // ==========================================
    const clock = new THREE.Clock();
    function animate() {
      requestAnimationFrame(animate);

      const delta = clock.getDelta();
      
      // Update time uniform for wave animation
      shaderMaterial.uniforms.time.value = clock.getElapsedTime();

      // --- Update 3D Scene ---
      
      // Rotate the plant model if loaded
      if (plantModel) {
        plantModel.rotation.y += delta * 0.5;
      }

      // --- Pass 1: Render 3D World to Low-Res Buffer ---
      renderer.setRenderTarget(renderTarget);
      renderer.render(scene, camera);

      // --- Pass 2: Render Buffer to Screen (ASCII Effect) ---
      renderer.setRenderTarget(null);
      renderer.render(postScene, postCamera);
    }

    animate();

    // Handle Window Resize
    window.addEventListener("resize", () => {
      // Update Camera
      const newAspect = window.innerWidth / window.innerHeight;
      camera.aspect = newAspect;
      camera.updateProjectionMatrix();

      // Update Renderer
      renderer.setSize(window.innerWidth, window.innerHeight);

      // Update Grid (Keep characters square)
      const newCols = Math.floor(ROWS * newAspect);
      renderTarget.setSize(newCols, ROWS);
      shaderMaterial.uniforms.gridSize.value.set(newCols, ROWS);
    });
  }
</script>
