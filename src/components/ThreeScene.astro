---
// src/components/ThreeScene.astro
// You can pass props to this component to customize it later
const { title = "My 3D Scene" } = Astro.props;
---

<div class="scene-container" data-title={title}></div>

<style>
  /* Ensure the container has size, otherwise the canvas will be 0px height */
  .scene-container {
    width: 100%;
    height: 100dvh; /* Or 100vh for full screen */
    background: rgb(33, 33, 33); /* Fallback color */
    overflow: hidden;
  }
</style>

<script>
  import * as THREE from 'three';
  import { AsciiEffect } from 'three/addons/effects/AsciiEffect.js';
  import { OBJLoader } from 'three/addons/loaders/OBJLoader.js';

  // Select the container
  const container = document.querySelector('.scene-container');

  if (container) {
    // --- SCENE SETUP ---
    const scene = new THREE.Scene();
    
    // --- CAMERA ---
    // PerspectiveCamera(Field of View, Aspect Ratio, Near Clip, Far Clip)
    const camera = new THREE.PerspectiveCamera(
      30, 
      container.clientWidth / container.clientHeight, 
      0.1, 
      1000
    );
    camera.position.z = 25;
    camera.position.y = 10;

    camera.lookAt(0, 0, 0);

    // --- RENDERER ---
    const renderer = new THREE.WebGLRenderer({ 
      antialias: true, // Smooth edges
      alpha: true      // Transparent background (lets CSS background show)
    });
    
    renderer.setSize(container.clientWidth, container.clientHeight);
    renderer.setPixelRatio(window.devicePixelRatio); // Sharpness on Retina screens
    
    // --- ASCII EFFECT ---
    // Lower resolution = larger ASCII characters (try 0.1 - 0.2)
    // Higher resolution = smaller ASCII characters (try 0.15 - 0.3)
    const effect = new AsciiEffect(renderer, ' .:-=+*#%@', { invert: false, resolution: 0.3 });
    effect.setSize(container.clientWidth, container.clientHeight);
    effect.domElement.style.color = 'white';
    effect.domElement.style.backgroundColor = 'transparent';
    
    // Make the ASCII effect background transparent
    const pre = effect.domElement;
    pre.style.background = 'transparent';
    
    container.appendChild(effect.domElement);

    // --- SHADERS ---
    const vertexShader = `
      varying vec3 vNormal;
      varying vec3 vPosition;
      uniform float uTime;
      
      void main() {
        vNormal = normalize(normalMatrix * normal);
        vPosition = position;
        
        // Add wave animation to vertices
        vec3 pos = position;
        // pos.z += sin(pos.x * 2.0 + uTime) * 0.1;
        // pos.y += cos(pos.z * 2.0 + uTime) * 0.1;
        
        gl_Position = projectionMatrix * modelViewMatrix * vec4(pos, 1.0);
      }
    `;
    
    const fragmentShader = `
      varying vec3 vNormal;
      varying vec3 vPosition;
      uniform float uTime;
      
      void main() {
        // Create color based on position and time
        vec3 color1 = vec3(0.2, 0.5, 1.0); // Blue
        vec3 color2 = vec3(1.0, 0.3, 0.5); // Pink
        vec3 color3 = vec3(0.3, 1.0, 0.5); // Green
        
        // Mix colors based on normal and time
        float mixValue = sin(vPosition.x + uTime) * 0.5 + 0.5;
        vec3 color = mix(color1, color2, mixValue);
        color = mix(color, color3, sin(vPosition.y + uTime * 0.5) * 0.5 + 0.5);
        
        // Add lighting based on normals
        float light = dot(vNormal, normalize(vec3(1.0, 1.0, 1.0))) * 0.5 + 0.5;
        color *= light;
        
        gl_FragColor = vec4(color, 1.0);
      }
    `;

    // --- OBJECT (The Mesh) ---
    // Load custom 3D model
    let mesh;
    const material = new THREE.ShaderMaterial({
      vertexShader: vertexShader,
      fragmentShader: fragmentShader,
      uniforms: {
        uTime: { value: 0.0 }
      }
    });
    
    const loader = new OBJLoader();
    loader.load(
      '/models/plant.obj', // Place your .obj file in public/models/
      (object) => {
        mesh = object;
        
        // Apply shader material to all meshes in the object
        mesh.traverse((child) => {
          if (child.isMesh) {
            child.material = material;
          }
        });
        
        scene.add(mesh);
      },
      (progress) => {
        console.log('Loading: ' + (progress.loaded / progress.total * 100) + '%');
      },
      (error) => {
        console.error('Error loading model:', error);
      }
    );

    // --- ANIMATION LOOP ---
    function animate() {
      requestAnimationFrame(animate);

      // Update time uniform for shader animation
      material.uniforms.uTime.value += 0.01;

      // Rotate the object (only if loaded)
      if (mesh) {
        // mesh.rotation.x += 0.01;
        mesh.rotation.y += 0.01;
      }

      effect.render(scene, camera);
    }
    
    animate();

    // --- RESIZE HANDLER ---
    // Crucial: Update camera and renderer when window resizes
    window.addEventListener('resize', () => {
      camera.aspect = container.clientWidth / container.clientHeight;
      camera.updateProjectionMatrix();
      effect.setSize(container.clientWidth, container.clientHeight);
    });
  }
</script>